    <!-- Annotations -->
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:University</AbbreviatedIRI><Literal xml:lang="en">University</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:University</AbbreviatedIRI><Literal xml:lang="en">An institution of higher education and research that grants academic degrees.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:UniversityMember</AbbreviatedIRI><Literal xml:lang="en">University Member</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:UniversityMember</AbbreviatedIRI><Literal xml:lang="en">A generic class representing any person affiliated with the university, encompassing both students and staff.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:Student</AbbreviatedIRI><Literal xml:lang="en">Student</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:Student</AbbreviatedIRI><Literal xml:lang="en">A person officially enrolled in a study programme or courses at the university.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:Employee</AbbreviatedIRI><Literal xml:lang="en">Employee</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:Employee</AbbreviatedIRI><Literal xml:lang="en">A person who is hired to provide services to the university on a regular basis.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:Teacher</AbbreviatedIRI><Literal xml:lang="en">Teacher</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:Teacher</AbbreviatedIRI><Literal xml:lang="en">An academic employee responsible for instructing courses and educating students.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:Classroom</AbbreviatedIRI><Literal xml:lang="en">Classroom</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:Classroom</AbbreviatedIRI><Literal xml:lang="en">A physical room within the university where educational activities and lectures take place.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:CourseEvaluation</AbbreviatedIRI><Literal xml:lang="en">Course Evaluation</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:CourseEvaluation</AbbreviatedIRI><Literal xml:lang="en">Feedback provided by a student regarding the quality and content of a specific course.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:studies</AbbreviatedIRI><Literal xml:lang="en">studies</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:studies</AbbreviatedIRI><Literal xml:lang="en">Relates a student to the university at which they study.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:hasStudent</AbbreviatedIRI><Literal xml:lang="en">has student</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:hasStudent</AbbreviatedIRI><Literal xml:lang="en">Relates a university to a student studying there.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:employs</AbbreviatedIRI><Literal xml:lang="en">employs</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:employs</AbbreviatedIRI><Literal xml:lang="en">Relates a university to an employee it employs.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:isEmployeeOf</AbbreviatedIRI><Literal xml:lang="en">is employee of</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:isEmployeeOf</AbbreviatedIRI><Literal xml:lang="en">Relates an employee to the university that employs them.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:isMemberOf</AbbreviatedIRI><Literal xml:lang="en">is member of</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:isMemberOf</AbbreviatedIRI><Literal xml:lang="en">Relates a university member to the university they participate in.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:hasMember</AbbreviatedIRI><Literal xml:lang="en">has member</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:hasMember</AbbreviatedIRI><Literal xml:lang="en">Relates a university to one of its members.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:enrolledIn</AbbreviatedIRI><Literal xml:lang="en">enrolled in</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:enrolledIn</AbbreviatedIRI><Literal xml:lang="en">Relates a student to a course in which they are enrolled.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:hasEnrolledStudent</AbbreviatedIRI><Literal xml:lang="en">has enrolled student</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:hasEnrolledStudent</AbbreviatedIRI><Literal xml:lang="en">Relates a course to a student enrolled in it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:takesPlaceIn</AbbreviatedIRI><Literal xml:lang="en">takes place in</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:takesPlaceIn</AbbreviatedIRI><Literal xml:lang="en">Relates a course to the classroom where it is taught.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:hostsCourse</AbbreviatedIRI><Literal xml:lang="en">hosts course</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:hostsCourse</AbbreviatedIRI><Literal xml:lang="en">Relates a classroom to a course taught in it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:teaches</AbbreviatedIRI><Literal xml:lang="en">teaches</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:teaches</AbbreviatedIRI><Literal xml:lang="en">Relates a teacher to a course they teach.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:isTaughtBy</AbbreviatedIRI><Literal xml:lang="en">is taught by</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:isTaughtBy</AbbreviatedIRI><Literal xml:lang="en">Relates a course to a teacher who teaches it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:registeredUnder</AbbreviatedIRI><Literal xml:lang="en">registered under</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:registeredUnder</AbbreviatedIRI><Literal xml:lang="en">Relates a teacher to the department under which they are registered.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:hasTeacher</AbbreviatedIRI><Literal xml:lang="en">has teacher</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:hasTeacher</AbbreviatedIRI><Literal xml:lang="en">Relates a department to a teacher registered under it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:isTaughtFor</AbbreviatedIRI><Literal xml:lang="en">is taught for</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:isTaughtFor</AbbreviatedIRI><Literal xml:lang="en">Relates a course to the study programme it is taught as a part of.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:containsCourse</AbbreviatedIRI><Literal xml:lang="en">contains course</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:containsCourse</AbbreviatedIRI><Literal xml:lang="en">Relates a study programme to a course taught as its part.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:offersProgramme</AbbreviatedIRI><Literal xml:lang="en">offers programme</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:offersProgramme</AbbreviatedIRI><Literal xml:lang="en">Relates a university to a study programme it offers.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:isOfferedBy</AbbreviatedIRI><Literal xml:lang="en">is offered by</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:isOfferedBy</AbbreviatedIRI><Literal xml:lang="en">Relates a study programme to the university offering it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:isPartOfFaculty</AbbreviatedIRI><Literal xml:lang="en">is part of faculty</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:isPartOfFaculty</AbbreviatedIRI><Literal xml:lang="en">Relates a department to the faculty it belongs to.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:containsDepartment</AbbreviatedIRI><Literal xml:lang="en">contains department</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:containsDepartment</AbbreviatedIRI><Literal xml:lang="en">Relates a faculty to a department belonging to it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:operatedBy</AbbreviatedIRI><Literal xml:lang="en">operated by</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:operatedBy</AbbreviatedIRI><Literal xml:lang="en">Relates a faculty to the university that operates it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:operatesFaculty</AbbreviatedIRI><Literal xml:lang="en">operates faculty</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:operatesFaculty</AbbreviatedIRI><Literal xml:lang="en">Relates a university to a faculty it operates.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:receivedEvaluation</AbbreviatedIRI><Literal xml:lang="en">received evaluation</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:receivedEvaluation</AbbreviatedIRI><Literal xml:lang="en">Relates a student to a course evaluation they received.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:wasGivenTo</AbbreviatedIRI><Literal xml:lang="en">was given to</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:wasGivenTo</AbbreviatedIRI><Literal xml:lang="en">Relates a course evaluation to the student it was given to.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:issuedEvaluation</AbbreviatedIRI><Literal xml:lang="en">issued evaluation</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:issuedEvaluation</AbbreviatedIRI><Literal xml:lang="en">Relates a teacher to a course evaluation they issued.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:wasIssuedBy</AbbreviatedIRI><Literal xml:lang="en">was issued by</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:wasIssuedBy</AbbreviatedIRI><Literal xml:lang="en">Relates a course evaluation to the teacher who issued it.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:issuedForCourse</AbbreviatedIRI><Literal xml:lang="en">issued for course</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:issuedForCourse</AbbreviatedIRI><Literal xml:lang="en">Relates a course evaluation to the course it evaluates.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><AbbreviatedIRI>:registeredEvaluation</AbbreviatedIRI><Literal xml:lang="en">registered evaluation</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><AbbreviatedIRI>:registeredEvaluation</AbbreviatedIRI><Literal xml:lang="en">Relates a course to an evaluation issued for it.</Literal></AnnotationAssertion>
</Ontology>
